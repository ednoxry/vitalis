# --- Supabase ---------------------------------------------------------------
# Crie um projeto em https://supabase.com e copie os valores em Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha a service role no cliente. Somente servidor (Vercel > Env Vars).
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail transacional (Resend) ------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Clínica Vitalis <nao-responda@clinicavitalis.com.br>"
CLINIC_NOTIFY_EMAIL=contato@clinicavitalis.com.br

# --- Público ----------------------------------------------------------------
NEXT_PUBLIC_CLINIC_WHATSAPP=5541999990000
NEXT_PUBLIC_SITE_URL=http://localhost:4181
CLINIC_TIMEZONE=America/Sao_Paulo

# --- Payload CMS (Marco 2) --------------------------------------------------
# Connection string do Postgres do Supabase (Project Settings > Database).
DATABASE_URI=
PAYLOAD_SECRET=

# --- Turnstile (anti-bot, opcional) ----------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
